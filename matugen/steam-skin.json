{
    "name": "matugen",
    "author": "simpbar",
    "description": "Material You (MD3 dark) Steam skin generated by matugen from your current wallpaper. Covers the library, friends, store, overlay, notifications, menus and Big Picture.",
    "version": "1.0.0",
    "tags": ["matugen", "material-you", "md3", "dark", "dynamic"],
    "Steam-WebKit": "steam-webkit.css",
    "Patches": [
        { "MatchRegexString": "^Steam$", "TargetCss": "steam-libraryroot.css" },
        { "MatchRegexString": ".friendsui-container", "TargetCss": "steam-friends.css" },
        { "MatchRegexString": "^Steam Overlay.*", "TargetCss": "steam-overlay.css" },
        { "MatchRegexString": "Notifications$", "TargetCss": "steam-notifications.css" },
        { "MatchRegexString": "^Steam Big Picture Mode$", "TargetCss": "steam-bigpicture.css" },
        { "MatchRegexString": ".*", "TargetCss": "steam-md3.css" },
        { "MatchRegexString": ".*", "TargetCss": "steam-menu.css" }
    ]
}