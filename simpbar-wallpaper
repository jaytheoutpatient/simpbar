#!/bin/bash
# simpbar-wallpaper — the wallpaper engine: list wallpapers, apply one with
# swaybg, retheme the desktop from it with matugen, and fetch new ones.
#
# Usage:
#   simpbar-wallpaper              open the wallpaper picker (drawer's Wallpapers tab)
#   simpbar-wallpaper list         print "path<TAB>name" per wallpaper, one per line
#   simpbar-wallpaper set <img>    apply <img>: swaybg + matugen + remember it
#   simpbar-wallpaper random       apply a random wallpaper from the folders
#   simpbar-wallpaper current      print the wallpaper currently remembered
#
# Fetching new ones (saved into the first wallpaper folder, not applied unless
# you say --apply):
#   simpbar-wallpaper bing [--count N]          download N of the last 8 Bing wallpapers
#   simpbar-wallpaper search <query> [opts]     list wallhaven.cc matches, TAB-separated
#   simpbar-wallpaper search <query> --save N   ...and download the first N of them
#   simpbar-wallpaper fetch <id|url> [--apply]  download one wallhaven.cc wallpaper
#   simpbar-wallpaper random --online           fetch a random wallhaven.cc wallpaper
#
# search/fetch/random options:
#   --page N        results page (default 1)
#   --atleast WxH   minimum resolution; "any" to disable (default 1920x1080)
#   --sorting S     favorites | toplist | date_added (default favorites)
#   --order O       asc | desc (default desc)
#   --category C    general | anime | nature | people, comma-separated, or
#                   "any". Enforced locally -- see below. Defaults: search ->
#                   general, random --online -> any (the random feed's general
#                   rows are almost all SFW, so filtering to them would hide
#                   what a configured key + --purity unlocks).
#   --purity P      100 sfw, 110 +questionable, 111 +explicit (default 100).
#                   Anything but 100 needs your own API key -- see below.
#   --seed S        shuffle seed; the same seed returns the same page
#   --save N        download the first N results (max 24)
#   --maxsize MB    skip wallpapers larger than this (default: no limit).
#                   Real ones run to 14 MB, so this is a metered-connection
#                   guard rather than a quality default.
#   --force         overwrite an already-downloaded file
#   --apply         apply it once downloaded
#   --minres WxH    random --online only: minimum resolution (default 1920x1080)
#
# Two things about wallhaven.cc's search that the defaults here work around:
#
#   * sorting=toplist is the API's own default and is a small hand-picked set --
#     "aurora borealis" has 2 results under it and 588 under favorites. Most
#     wallpaper wants people actually saved a wallpaper, so favorites is ours.
#
#   * categories is accepted by /search and then ignored: general, nature and
#     anime all return the same total, and nature/people never come back at all.
#     The category is therefore filtered here rather than trusted to the API, so
#     --category means what it says. The cost is that a filtered page can come
#     back empty while later pages have matches; the "no matches" message says
#     so rather than pretending the query found nothing.
#
#   * the single-wallpaper lookup, /api/v1/f/<id>, requires an API key even for
#     SFW content -- it 404s anonymously even for ids the search endpoint just
#     handed out. `search` therefore returns the direct image URL as its last
#     column, `search --save N` downloads straight from those, and `fetch`
#     accepts a URL as readily as an id. Nothing in the common path needs an
#     account.
#
# Accounts and content rating. wallhaven.cc's SFW search needs no credentials.
# Anything else does, and it is your key and your account — in
# ~/.config/simpbar/wallhaven:
#       key=<your key from https://wallhaven.cc/user/settings/api>
#       purity=100
#   or export WALLHAVEN_APIKEY=... in the environment. SFW is the default and
#   stays the default when no key is present — an adult-rated wallpaper
#   appearing on screen because a key happened to be lying around is not a
#   trade this script makes on your behalf.
#
# This replaces waypaper as the thing that owns the wallpaper. waypaper is a GUI
# front-end whose real job is exactly these four steps; keeping it in the loop
# meant two programs could disagree about the current wallpaper, and the bar
# ended up themed from a different image than the one on screen.
#
# Why each step matters:
#
#   * swaybg is the actual wallpaper daemon (waypaper, azote and the old
#     ~/wallpaper-switcher were all just front-ends to it). The new process is
#     started *before* the old one is killed, so the screen never flashes black;
#     the reverse order shows bare desktop for a frame on every switch.
#
#   * matugen recolors the bar, terminal, GTK, Qt and the rest from the image.
#     It runs on whatever image is picked — no wallpaper is special-cased.
#
#   * The chosen path is written to ~/.config/simpbar/wallpaper so
#     simpbar-restore-wallpaper can bring it back at login. That replaces
#     waypaper's --restore.
#
# Wallpaper folders come from ~/.config/simpbar/wallpaper-dirs (one per line,
# ~ expanded), defaulting to the XDG pictures dir. Image types match the set
# swaybg can actually load; matching is case-insensitive because real
# collections are full of things like ".JPG".

set -uo pipefail

CONFIG_DIR="$HOME/.config/simpbar"
DIRS_FILE="$CONFIG_DIR/wallpaper-dirs"
STATE_FILE="$CONFIG_DIR/wallpaper"

# swaybg's usable image formats. Keep in sync with what swaybg can decode —
# anything else fails silently and leaves you looking at a stale wallpaper.
IMAGE_EXTS="jpg jpeg png gif webp bmp pnm tiff tif avif"

FILL="fill"
COLOR="#ffffff"

die() { echo "simpbar-wallpaper: $*" >&2; exit 1; }
log() { echo "simpbar-wallpaper: $*" >&2; }

# Same message, but returns instead of exiting. Needed inside a command
# substitution: `exit 1` in a subshell exits only the subshell, so a helper that
# dies while being called as `x="$(helper)"` leaves the caller running on with an
# empty string where a validated value should be. That is how a refused
# --purity 111 still went on to run an unfiltered search.
fatal() { log "$@"; return 1; }

# ---------------------------------------------------------------------------
# Folders
# ---------------------------------------------------------------------------

default_dirs() {
    # XDG pictures dir, falling back to the conventional ~/Pictures/Wallpaper
    # on systems that don't set XDG_PICTURES_DIR. Printed one per line.
    if [ -n "${XDG_PICTURES_DIR:-}" ]; then
        echo "${XDG_PICTURES_DIR%/}/Wallpaper"
    else
        echo "$HOME/Pictures/Wallpaper"
    fi
}

# Expand a leading ~ or ~/ anywhere in the path. Written as a case instead of
# using `eval` so a folder line containing spaces or quotes stays one path.
expand_tilde() {
    case "$1" in
        "~") echo "$HOME" ;;
        "~/"*) echo "$HOME/${1#\~/}" ;;
        *) echo "$1" ;;
    esac
}

read_dirs() {
    if [ -r "$DIRS_FILE" ]; then
        # Skip blanks and #comments; expand ~ per line.
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ''|\#*) continue ;;
            esac
            expand_tilde "$line"
        done < "$DIRS_FILE"
    else
        default_dirs
    fi
}

# ---------------------------------------------------------------------------
# Enumeration
# ---------------------------------------------------------------------------

# True when $1 has an image extension swaybg can load. Lowercased before
# matching so ".JPG" and ".jpg" are the same file type.
is_image() {
    local f="${1,,}" ext
    for ext in $IMAGE_EXTS; do
        case "$f" in
            *".$ext") return 0 ;;
        esac
    done
    return 1
}

# Every image across every configured folder, sorted by name. Missing folders
# are skipped silently: a user who deleted ~/Pictures/Wallpaper should get an
# empty list, not an error.
list_images() {
    local dir f
    while IFS= read -r dir; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*; do
            [ -f "$f" ] || continue
            is_image "$f" || continue
            printf '%s\n' "$f"
        done
    done < <(read_dirs) | sort
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

# Read one key out of the state file. Written by hand rather than with grep so a
# path containing spaces (which every AI-generated wallpaper name does) comes
# back whole.
state_get() {
    [ -r "$STATE_FILE" ] || return 1
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "$1="*) printf '%s' "${line#*=}"; return 0 ;;
        esac
    done < "$STATE_FILE"
    return 1
}

state_set() {
    local tmp="$STATE_FILE.tmp.$$"
    mkdir -p "$CONFIG_DIR" || die "cannot create $CONFIG_DIR"
    # Preserve any keys we don't know about, so a future version's settings
    # survive an older script rewriting the file.
    if [ -r "$STATE_FILE" ]; then
        grep -v "^$1=" "$STATE_FILE" > "$tmp" 2>/dev/null || true
    else
        : > "$tmp"
    fi
    printf '%s=%s\n' "$1" "$2" >> "$tmp"
    # Replace atomically: a half-written state file would restore no wallpaper
    # at all after a reboot.
    mv -f "$tmp" "$STATE_FILE" || { rm -f "$tmp"; die "cannot write $STATE_FILE"; }
}

# ---------------------------------------------------------------------------
# Applying
# ---------------------------------------------------------------------------

# Swap the running swaybg over to $1. Returns non-zero if swaybg is missing so
# callers can report it rather than pretending the wallpaper changed.
apply_swaybg() {
    local img="$1" monitor="$2"

    if ! command -v swaybg >/dev/null 2>&1; then
        return 1
    fi

    # Only swaybg processes that are actually setting an image (-i). Skipping
    # the rest leaves a deliberate multi-monitor setup alone instead of killing
    # a window the user placed themselves. `-x` matches the process name
    # exactly, so this cannot match the grep/pgrep pipeline itself the way
    # `pgrep -f swaybg` can.
    local old_pids
    old_pids="$(pgrep -x swaybg 2>/dev/null || true)"

    local -a cmd=(swaybg)
    [ -n "$monitor" ] && cmd+=(-o "$monitor")
    cmd+=(-i "$img" -m "$FILL" -c "$COLOR")

    # setsid so swaybg survives this script exiting and is not reaped when the
    # session's process group is cleaned up — same reason waypaper's Popen
    # leaves it running.
    if command -v setsid >/dev/null 2>&1; then
        setsid "${cmd[@]}" >/dev/null 2>&1 &
    else
        "${cmd[@]}" >/dev/null 2>&1 &
    fi
    local new_pid=$!

    # Give swaybg a moment to map its surface before the old one goes away,
    # otherwise there is a visible black frame on every switch.
    sleep 0.3

    local pid
    for pid in $old_pids; do
        [ "$pid" = "$new_pid" ] && continue
        kill "$pid" 2>/dev/null || true
    done

    # Confirm something survived: if swaybg died immediately (unreadable file,
    # bad decoder) say so instead of leaving a stale wallpaper looking correct.
    sleep 0.2
    if [ -n "$new_pid" ] && ! kill -0 "$new_pid" 2>/dev/null; then
        if ! pgrep -x swaybg >/dev/null 2>&1; then
            log "swaybg exited immediately — is this file a format swaybg can read?"
            return 2
        fi
    fi
    return 0
}

# Push the desktop's colors at $1. A theming failure is reported but does NOT
# fail the whole operation: the wallpaper is already up and visible, and failing
# here would make the picker look like it did nothing.
#
# matugen's own output is captured to a log rather than passed through. matugen
# 4.x prints ~140 lines to stdout on every run (a full fastfetch dump, repeated
# once per post_hook it fires), and this script's stdout is the machine-readable
# result the app drawer's model parses -- a "Setting…" status field full of ASCII
# art, and a `current` value that is not a path, are both strictly worse than
# nothing. It is still available for debugging in the log.
apply_matugen() {
    local img="$1"
    if [ -x /usr/bin/simpbar-matugen ]; then
        MATUGEN_CMD=/usr/bin/simpbar-matugen
    elif command -v simpbar-matugen >/dev/null 2>&1; then
        MATUGEN_CMD="$(command -v simpbar-matugen)"
    else
        log "simpbar-matugen not found — wallpaper set, but colors were not regenerated"
        return 0
    fi
    local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/simpbar"
    if mkdir -p "$log_dir" 2>/dev/null; then
        # Truncated per run: this is a diagnostic tail, not a history, and an
        # append-only file here would grow without bound.
        if ! "$MATUGEN_CMD" "$img" >"$log_dir/matugen.log" 2>&1; then
            log "matugen failed on $(basename "$img") — wallpaper is set, colors may be stale"
            log "  see $log_dir/matugen.log"
        fi
    else
        # No writable state dir: discard the noise rather than corrupt stdout.
        "$MATUGEN_CMD" "$img" >/dev/null 2>&1 \
            || log "matugen failed on $(basename "$img") — wallpaper is set, colors may be stale"
    fi
    return 0
}

cmd_set() {
    local img="$1" monitor="${2:-}"

    # Expand a leading ~ so `simpbar-wallpaper set ~/Pictures/...` works when
    # quoted or unquoted. A quoted "~" never expands on its own, which is
    # exactly the trap that made matugen only ever theme Bing wallpapers.
    img="$(expand_tilde "$img")"
    img="${img/#\~/$HOME}"
    [ -n "$img" ] || die "no wallpaper path given"
    [ -f "$img" ] || die "not a file: $img"
    is_image "$img" || die "unsupported image type: $img (expected one of: $IMAGE_EXTS)"

    local rc=0
    apply_swaybg "$img" "$monitor" || rc=$?
    case "$rc" in
        1) die "swaybg isn't installed — nothing was changed" ;;
        2) die "swaybg could not display $(basename "$img")" ;;
    esac

    # Remember it before theming so a matugen crash still leaves a restorable
    # wallpaper rather than reverting to whatever was there before.
    state_set path "$img"
    state_set fill "$FILL"
    state_set color "$COLOR"

    apply_matugen "$img"
    printf '%s\n' "$img"
}

cmd_list() {
    local f
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        printf '%s\t%s\n' "$f" "$(basename "$f")"
    done < <(list_images)
}

# Print the image swaybg is currently displaying, or fail.
#
# Reads /proc/<pid>/cmdline (NUL-separated argv) rather than `pgrep -a swaybg`.
# ps joins argv with spaces, which is unrecoverable for a filename containing
# spaces — and every AI-generated wallpaper has them. argv boundaries are the
# only way to tell where the path ends.
swaybg_current_image() {
    local pid arg next=""
    pid="$(pgrep -x swaybg 2>/dev/null | head -n1)"
    [ -n "$pid" ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    while IFS= read -r -d '' arg; do
        if [ -n "$next" ]; then printf '%s' "$arg"; return 0; fi
        [ "$arg" = "-i" ] && next=1
    done < "/proc/$pid/cmdline"
    return 1
}

cmd_current() {
    local p
    if p="$(state_get path)"; then
        printf '%s\n' "$(expand_tilde "$p")"
        return 0
    fi
    # No state of ours. Report whatever swaybg actually has on screen so the
    # picker can highlight the right tile even on a first run.
    if p="$(swaybg_current_image)"; then
        printf '%s\n' "$p"
        return 0
    fi
    return 1
}

cmd_random() {
    # `--online` fetches a new one instead of choosing from what is on disk.
    case "${1:-}" in
        --online) shift; cmd_random_online "$@"; return $? ;;
    esac
    local n
    n="$(list_images | wc -l)"
    [ "$n" -gt 0 ] || die "no wallpapers found in: $(read_dirs | tr '\n' ' ')"
    local img
    img="$(list_images | sed -n "$((RANDOM % n + 1))p")"
    [ -n "$img" ] || die "could not pick a wallpaper"
    cmd_set "$img"
}

# The usage block for the fetch subcommands, which all share one option set.
# Anchored on two marker lines that live in the header, so it cannot run away to
# the end of the file the way a `sed` range with a typo'd end pattern does.
fetch_help() {
    awk '/^# Fetching new ones/ { on = 1 }
         /^# Accounts and content rating/ { on = 0 }
         on { sub(/^# ?/, ""); print }' "$0"
}

# ---------------------------------------------------------------------------
# Fetching
# ---------------------------------------------------------------------------
#
# Only the subcommands below need the network, and they are the only ones that
# need curl and python3. list/set/random/current keep working on a machine
# without either, so a wallpaper you already have is never gated behind being
# able to download a new one.
#
# Output discipline is the same as the rest of the script: stdout is paths, one
# per line, and everything meant for a human goes to stderr. That is what makes
# `search ... | cut -f1 | xargs -n1 fetch --apply` work.

API_TIMEOUT=30          # seconds per request
UA="simpbar-wallpaper/1.0 (+https://github.com/jaytheoutpatient/simpbar)"

need_curl() {
    command -v curl >/dev/null 2>&1 \
        || die "curl is required to download wallpapers"
}

need_json() {
    command -v python3 >/dev/null 2>&1 \
        || die "python3 is required to read the download APIs' JSON"
}

# The folder new wallpapers land in: the first configured one, so they show up
# in the picker without any further configuration. Returns non-zero rather than
# dying, because callers reach this through a command substitution.
first_dir() {
    local d
    d="$(read_dirs | head -n1)"
    [ -n "$d" ] || fatal "no wallpaper folder configured"
    [ -n "$d" ] || return 1
    printf '%s' "$d"
}

# True when $1 is a plausible wallpaper: real image magic bytes, and big enough
# to be one.
#
# The magic bytes are checked rather than the extension because the extension is
# exactly what is unverified -- the server chose it. But magic bytes alone are
# not enough either: Bing answers an unknown image id with HTTP 200 and a 1192
# byte 1x1 JPEG, which passes every byte check and would land in the wallpaper
# folder as a plausible-looking .jpg that swaybg happily stretches across the
# screen and matugen themes from. Real Bing files are 330 KB (1080p) and 3.6 MB
# (UHD), so a floor this low still leaves two orders of magnitude of headroom.
MIN_IMAGE_BYTES=16384

is_real_image() {
    local sig
    [ -s "$1" ] || return 1
    [ "$(wc -c < "$1")" -ge "$MIN_IMAGE_BYTES" ] || return 1
    # NOTE: a case glob has to match the *whole* string, so every pattern below
    # needs a trailing `*`. Without one the pattern can never fire at all, which
    # is silently how the AVIF/HEIC check ended up being dead code.
    sig="$(head -c 12 "$1" | od -An -tx1 2>/dev/null | tr -d ' \n')"
    case "$sig" in
        ffd8ff*)                          return 0 ;;  # jpeg
        89504e470d0a1a0a*)                return 0 ;;  # png
        474946383[79]61*)                 return 0 ;;  # gif
        52494646????????57454250*)        return 0 ;;  # webp (RIFF....WEBP)
        424d????????????????*)            return 0 ;;  # bmp
        49492a00*|4d4d002a*)               return 0 ;;  # tiff (LE/BE)
        ????????66747970????*)             return 0 ;;  # avif/heic (....ftyp....)
        *)                               return 1 ;;
    esac
}

# Download $1 to $2 atomically: into a .part sibling, verified, then renamed.
# A half-finished or non-image download therefore never becomes a wallpaper the
# picker offers. Returns 0 on success, 1 on transfer failure, 2 on a bad file.
fetch_to() {
    local url="$1" dest="$2" tmp="$2.part"
    mkdir -p "$(dirname "$dest")" || return 1
    rm -f "$tmp"
    if ! curl -fsSL --retry 2 --retry-delay 1 --max-time "$API_TIMEOUT" \
         -A "$UA" -o "$tmp" "$url" 2>/dev/null; then
        rm -f "$tmp"
        return 1
    fi
    if ! is_real_image "$tmp"; then
        rm -f "$tmp"
        return 2
    fi
    mv -f "$tmp" "$dest" 2>/dev/null || { rm -f "$tmp"; return 1; }
    return 0
}

# GET $1 and print the JSON body, or fail with a reason that names the actual
# cause.
#
# Deliberately not using `curl -f`. With --fail, a 404 from wallhaven.cc looks
# exactly like an unplugged network cable, and "no such wallpaper" is the single
# most common thing to get wrong here. So the status is captured and reported:
# 404 is a bad id, 429 is throttling, 5xx is their problem, and only a non-zero
# curl exit is ours.
api_get() {
    local url="$1" tmp code rc=0
    tmp="$(mktemp)" || { log "could not create a temporary file"; return 1; }
    code="$(curl -sSL --retry 2 --retry-delay 1 --max-time "$API_TIMEOUT" \
              -A "$UA" -o "$tmp" -w '%{http_code}' "$url" 2>/dev/null)" || rc=$?

    if [ "$rc" -ne 0 ] || [ -z "$code" ] || [ "$code" = "000" ]; then
        rm -f "$tmp"
        log "could not reach the server (curl exit $rc)"
        log "  check your network connection"
        return 1
    fi
    case "$code" in
        2*) : ;;
        404) rm -f "$tmp"
             log "the server has no such entry (HTTP 404)"
             return 1 ;;
        429) rm -f "$tmp"
             # wallhaven.cc publishes a window of 45; make no such claim about
             # the other host on this URL, so the message stays truthful for
             # whatever this was called against.
             log "rate limited by the server (HTTP 429)"
             log "  wait a minute and try again"
             return 1 ;;
        *)   rm -f "$tmp"
             log "the server returned HTTP $code"
             return 1 ;;
    esac
    # A captive portal serving a 200 login page would otherwise parse as an
    # empty result set.
    if ! head -c 1 "$tmp" 2>/dev/null | grep -q '{'; then
        rm -f "$tmp"
        log "unexpected response (not JSON) — a proxy or captive portal?"
        return 1
    fi
    cat "$tmp"
    rm -f "$tmp"
    return 0
}

# Percent-encode $1. Hand-rolling this is how you get a query with a space in it
# silently turning into a different search.
urlenc() {
    python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

# --- wallhaven.cc ----------------------------------------------------------
#
# https://wallhaven.cc/api — SFW search needs no credentials; anything else
# does. Read in the same key=value shape as the rest of ~/.config/simpbar.

wallhaven_conf() {
    local f="$CONFIG_DIR/wallhaven" line
    if [ -r "$f" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                "$1="*) printf '%s' "${line#*=}"; return 0 ;;
            esac
        done < "$f"
    fi
    return 1
}

wallhaven_key() {
    [ -n "${WALLHAVEN_APIKEY:-}" ] && { printf '%s' "$WALLHAVEN_APIKEY"; return 0; }
    wallhaven_conf key
}

# Validated content rating. Bit 1 is SFW, bit 2 questionable, bit 3 explicit —
# a 3-digit 0/1 mask, which is a poor format and the one thing here worth
# refusing rather than guessing at. Returns non-zero instead of dying, since
# every caller reads this through a command substitution.
wallhaven_purity() {
    local p="${1:-}"
    [ -n "$p" ] || p="$(wallhaven_conf purity || printf '100')"
    case "$p" in
        100|110|111|010|011|001|101) ;;
        *) fatal "invalid --purity '$p' (want 100, 110 or 111)"; return 1 ;;
    esac
    if [ "$p" != "100" ] && ! wallhaven_key >/dev/null; then
        fatal "--purity $p needs your wallhaven.cc API key; add 'key=...' to $CONFIG_DIR/wallhaven or set WALLHAVEN_APIKEY"
        return 1
    fi
    printf '%s' "$p"
}

# "&apikey=..." when there is a key, empty otherwise. Omitting the parameter
# entirely is different from sending an empty one: the latter is an auth error
# from the API, not an anonymous request.
wallhaven_authopts() {
    local k
    k="$(wallhaven_key || true)"
    [ -n "$k" ] && printf '&apikey=%s' "$(urlenc "$k")"
}

# Print "id<TAB>url<TAB>ext<TAB>category" for one record read on stdin.
# jpg/webp/png only: those are what the API serves, and they are all things
# swaybg and matugen can read.
wallhaven_one() {
    python3 -c '
import json, sys
d = (json.load(sys.stdin).get("data") or {})
ext = {"image/jpeg": "jpg", "image/png": "png", "image/webp": "webp"}.get(d.get("file_type"), "jpg")
print("\t".join([str(d.get("id") or ""), str(d.get("path") or ""), ext, str(d.get("category") or "")]))
'
}

# Print "id<TAB>extension" parsed out of a wallhaven image URL:
#   https://w.wallhaven.cc/full/m9/wallhaven-m9rmw1.jpg
# The `search` output already carries this URL, so the id and type can be had
# without asking the API anything -- which matters, because wallhaven's
# single-wallpaper lookup (/api/v1/f/<id>) requires an API key even for SFW
# content, and so is unusable for an anonymous user.
wallhaven_id_ext_from_url() {
    python3 -c '
import re, sys, urllib.parse
path = urllib.parse.urlparse(sys.argv[1]).path
m = re.search(r"wallhaven-([0-9a-zA-Z]+)\.([A-Za-z0-9]+)$", path)
print("\t".join(m.groups()) if m else "\t")
' "$1"
}

# Download one wallhaven image to the wallpaper folder as wallhaven-<id>.<ext>.
# Prints the saved path. Returns 0 saved-or-already-present, 1 on failure.
save_wallhaven() {
    local url="$1" id="$2" ext="$3" force="${4:-0}" dest dir
    dir="$(first_dir)" || exit 1
    dest="$dir/wallhaven-${id:-$(date +%s)}.${ext:-jpg}"
    if [ -e "$dest" ] && [ "$force" -eq 0 ]; then
        log "already have $(basename "$dest")"
    else
        # NOTE: `case "$(fetch_to …)"` would always fall through to the default
        # branch — command substitution captures stdout, and the exit status is
        # only readable as $?. fetch_to prints nothing, so the case word would
        # always be the empty string.
        local rc=0
        fetch_to "$url" "$dest" || rc=$?
        case "$rc" in
            0) log "saved $(basename "$dest")" ;;
            2) log "$(basename "$dest"): the server did not return an image"; return 1 ;;
            *) log "could not download $(basename "$dest")"; return 1 ;;
        esac
    fi
    printf '%s\n' "$dest"
    return 0
}

