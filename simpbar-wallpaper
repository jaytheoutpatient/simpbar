# id, resolution, category/purity, favourites, views, dominant colours, URL.
# TAB-separated so `cut -f1` is the id and the rest is still there to read.
cmd_search() {
    local query="" page=1 atleast="1920x1080" sorting="favorites" order="desc"
    local category="general" purity="" seed="" save=0 force=0 apply=0 arg
    local maxsize=0

    while [ $# -gt 0 ]; do
        arg="$1"
        case "$arg" in
            --page)      page="${2:-}"; shift 2 || die "--page needs a number" ;;
            --page=*)    page="${arg#*=}"; shift ;;
            --atleast)   atleast="${2:-}"; shift 2 || die "--atleast needs WxH" ;;
            --atleast=*) atleast="${arg#*=}"; shift ;;
            --sorting)   sorting="${2:-}"; shift 2 || die "--sorting needs a value" ;;
            --sorting=*) sorting="${arg#*=}"; shift ;;
            --order)     order="${2:-}"; shift 2 || die "--order needs asc or desc" ;;
            --order=*)   order="${arg#*=}"; shift ;;
            --category)  category="${2:-}"; shift 2 || die "--category needs a value" ;;
            --category=*) category="${arg#*=}"; shift ;;
            --purity)    purity="${2:-}"; shift 2 || die "--purity needs a value" ;;
            --purity=*)  purity="${arg#*=}"; shift ;;
            --seed)      seed="${2:-}"; shift 2 || die "--seed needs a value" ;;
            --seed=*)    seed="${arg#*=}"; shift ;;
            --save)      save="${2:-}"; shift 2 || die "--save needs a count" ;;
            --maxsize)   maxsize="${2:-}"; shift 2 || die "--maxsize needs a number of MB" ;;
            --maxsize=*) maxsize="${arg#*=}"; shift ;;
            --save=*)    save="${arg#*=}"; shift ;;
            --force)     force=1; shift ;;
            --apply)     apply=1; shift ;;
            -h|--help)   fetch_help; return 0 ;;
            -*)          die "unknown option for search: $arg" ;;
            *)           query="${query:+$query }$arg"; shift ;;
        esac
    done

    need_curl; need_json

    [ -n "$query" ] || die "search needs a query (try: simpbar-wallpaper search 'northern lights')"
    case "$page" in ''|*[!0-9]*) die "--page must be a number" ;; esac
    [ "$page" -ge 1 ] || die "--page starts at 1"
    case "$save" in ''|*[!0-9]*) die "--save needs a count" ;; esac
    [ "$save" -le 24 ] || die "--save is at most 24 (one page of results)"
    case "$maxsize" in ''|*[!0-9]*) die "--maxsize must be a number of MB" ;; esac
    case "$sorting" in favorites|toplist|date_added) ;; *) die "--sorting must be favorites, toplist or date_added" ;; esac
    case "$order" in asc|desc) ;; *) die "--order must be asc or desc" ;; esac
    # Comma-separated, because the API's own categories parameter takes a list
    # even though it then ignores it.
    local c
    for c in ${category//,/ }; do
        case "$c" in
            general|anime|nature|people) ;;
            *) die "--category must be general, anime, nature or people (comma-separated), or 'any'" ;;
        esac
    done
    [ "$category" = "any" ] && category=""
    if [ "$atleast" != "any" ] && ! printf '%s' "$atleast" | grep -Eq '^[0-9]+x[0-9]+$'; then
        die "--atleast must be WxH (1920x1080) or 'any'"
    fi

    purity="$(wallhaven_purity "$purity")" || exit 1

    # categories is sent because it costs nothing and may start working, but the
    # result is filtered locally as well -- see the header.
    local url="https://wallhaven.cc/api/v1/search"
    url="$url?q=$(urlenc "$query")&purity=$purity"
    [ -n "$category" ] && url="$url&categories=$(urlenc "$category")"
    url="$url&sorting=$sorting&order=$order&page=$page"
    [ "$atleast" != "any" ] && url="$url&atleast=$atleast"
    [ -n "$seed" ] && url="$url&seed=$(urlenc "$seed")"
    url="$url$(wallhaven_authopts)"

    local json
    json="$(api_get "$url")" || return 1

    local n
    n="$(printf '%s' "$json" | python3 -c '
import json, sys
want = set(filter(None, sys.argv[1].split(",")))
maxsize = int(sys.argv[2]) * 1024 * 1024
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
rows = []
for w in (d.get("data") or []):
    if want and str(w.get("category") or "") not in want:
        continue
    size = w.get("file_size")
    if maxsize and isinstance(size, int) and size > maxsize:
        continue
    rows.append("\t".join([
        str(w.get("id") or ""),
        str(w.get("resolution") or ""),
        "%s/%s" % (w.get("category") or "", w.get("purity") or ""),
        str(size if size is not None else ""),
        str(w.get("favorites") if w.get("favorites") is not None else ""),
        ",".join(w.get("colors") or []),
        str(w.get("path") or ""),
    ]))
print("\n".join(rows))
' "$category" "$maxsize")" || { log "could not read the API's response"; return 1; }

    if ! printf '%s' "$n" | grep -q '[^[:space:]]'; then
        local total
        total="$(printf '%s' "$json" | python3 -c '
import json, sys
try: print(json.load(sys.stdin).get("meta", {}).get("total", ""))
except Exception: print("")
')"
        if [ -n "$category" ]; then
            log "no '${category}' results for \"$query\" on page $page"
            log "  the API does not filter by category itself, so this is filtered here --"
            log "  the page may simply have had other categories on it. Try --page $((page + 1)) or --category any"
        else
            log "no results for \"$query\" (purity=$purity, min ${atleast})"
        fi
        return 1
    fi

    # --save hands out the paths only; the results stay on stderr so a saved run
    # still shows what it found.
    if [ "$save" -gt 0 ]; then
        local first="" sid surl sext sdest rc=0
        while IFS=$'\t' read -r sid _sres _scat _ssize _sfav _scols surl; do
            [ "$save" -gt 0 ] || break
            [ -n "$surl" ] || continue
            # The id and type come straight out of the URL, so nothing else is
            # asked of the API -- which is what makes saving work without a key.
            IFS=$'\t' read -r sid sext < <(wallhaven_id_ext_from_url "$surl")
            [ -n "$sid" ] || continue
            sdest="$(save_wallhaven "$surl" "$sid" "$sext" "$force")" || { rc=1; continue; }
            # save_wallhaven's path went into $sdest via command substitution, so
            # it has to be re-emitted here for stdout to stay "paths only".
            printf '%s\n' "$sdest"
            [ -n "$first" ] || first="$sdest"
            save=$((save - 1))
        done <<< "$n"
        if [ "$apply" -eq 1 ] && [ -n "$first" ]; then
            log "applying the first result"
            cmd_set "$first"
        fi
        return "$rc"
    fi

    printf '%s\n' "$n"
    return 0
}

# Download one wallpaper, given either a wallhaven id or a direct image URL.
# Prints the saved path.
cmd_fetch() {
    local target="" apply=0 force=0 arg
    while [ $# -gt 0 ]; do
        arg="$1"
        case "$arg" in
            --apply) apply=1; shift ;;
            --force) force=1; shift ;;
            -h|--help) fetch_help; return 0 ;;
            -*) die "unknown option for fetch: $arg" ;;
            *) target="$arg"; shift ;;
        esac
    done
    [ -n "$target" ] || die "fetch needs an id or a URL (see: simpbar-wallpaper search --help)"
    need_curl

    local url id ext dest rec
    case "$target" in
        http://*|https://*)
            # Already a direct link. No API round trip, so no key needed.
            url="$target"
            IFS=$'\t' read -r id ext < <(wallhaven_id_ext_from_url "$url")
            if [ -z "$id" ]; then
                log "'$target' does not look like a wallhaven image URL"
                log "  expected something like https://w.wallhaven.cc/full/xx/wallhaven-xxxxx.jpg"
                return 1
            fi
            dest="$(save_wallhaven "$url" "$id" "$ext" "$force")" || return 1
            ;;
        */*|*://*)
            die "'$target' looks like a path, not a wallpaper id — use: simpbar-wallpaper set $target"
            ;;
        *)
            need_json
            rec="$(api_get "https://wallhaven.cc/api/v1/f/$target$(wallhaven_authopts)")" || {
                if ! wallhaven_key >/dev/null; then
                    log "wallhaven requires an API key to look an id up, even for SFW content."
                    log "  Add key=... to $CONFIG_DIR/wallhaven, or skip the lookup entirely:"
                    log "    simpbar-wallpaper search '<query>' --save 1"
                    log "    simpbar-wallpaper fetch <url-from-search>"
                fi
                return 1
            }
            IFS=$'\t' read -r id url ext _cat <<< "$(printf '%s' "$rec" | wallhaven_one)"
            [ -n "$url" ] || die "no downloadable file for id $target (it may need an API key at that rating)"
            dest="$(save_wallhaven "$url" "$id" "$ext" "$force")" || return 1
            ;;
    esac

    [ "$apply" -eq 1 ] && cmd_set "$dest"
    return 0
}

# One random wallpaper from the internet. Unlike bing/search this applies what
# it downloads: `random` is the verb that means "put something on my screen",
# and fetching without showing it would be `fetch` with dice.
#
# Built on /search?sorting=random rather than wallhaven's /api/v1/random, which
# currently answers HTTP 404 to every anonymous request regardless of its
# parameters. The search endpoint has a documented random sort over the whole
# catalogue and does work.
cmd_random_online() {
    # api_url and img_url are deliberately distinct names: on the first retry
    # the loop overwrote `url` with the image URL and the next api_get fetched a
    # JPEG, which then failed the "is this JSON" check.
    # Default to every category rather than general: the random feed's general
    # rows are almost all SFW (9/9 on page after page), while the sketchy and
    # explicit rows cluster in anime and people. Filtering to general would
    # therefore go on serving SFW even after someone configured a key and
    # purity=110/111 -- hiding exactly what the key unlocks. Purity still gates
    # the whole thing, so SFW-only defaults are unaffected.
    local purity="" minres="1920x1080" category="" arg api_url json
    local rec got_id img_url imgext got_cat dest rc=0
    while [ $# -gt 0 ]; do
        arg="$1"
        case "$arg" in
            --purity)   purity="${2:-}"; shift 2 || die "--purity needs a value" ;;
            --purity=*) purity="${arg#*=}"; shift ;;
            --minres)   minres="${2:-}"; shift 2 || die "--minres needs WxH" ;;
            --minres=*) minres="${arg#*=}"; shift ;;
            --category) category="${2:-}"; shift 2 || die "--category needs a value" ;;
            --category=*) category="${arg#*=}"; shift ;;
            -h|--help)  fetch_help; return 0 ;;
            *) die "unknown option for --online: $arg" ;;
        esac
    done
    need_curl; need_json

    if [ "$minres" != "any" ] && ! printf '%s' "$minres" | grep -Eq '^[0-9]+x[0-9]+$'; then
        die "--minres must be WxH (1920x1080) or 'any'"
    fi
    local c
    for c in ${category//,/ }; do
        case "$c" in
            general|anime|nature|people) ;;
            *) die "--category must be general, anime, nature or people (comma-separated), or 'any'" ;;
        esac
    done
    [ "$category" = "any" ] && category=""

    purity="$(wallhaven_purity "$purity")" || exit 1

    api_url="https://wallhaven.cc/api/v1/search?sorting=random&purity=$purity"
    [ -n "$category" ] && api_url="$api_url&categories=$(urlenc "$category")"
    [ "$minres" != "any" ] && api_url="$api_url&atleast=$minres"
    api_url="$api_url$(wallhaven_authopts)"

    # categories is ignored by this endpoint like every other, so a mismatched
    # category is expected rather than exceptional: draw again until one turns
    # up instead of accepting a wallpaper from the wrong genre. Each draw scans
    # the whole page (24 rows), not just the first result — with nature at ~10%
    # of the catalogue, the first row of a page matches only sometimes, but a
    # whole page matches almost always, so this rarely needs a second round trip.
    local attempt=0 max_tries=6 got_cat="" matched=0
    while [ "$attempt" -lt "$max_tries" ]; do
        attempt=$((attempt + 1))
        json="$(api_get "$api_url")" || return 1
        # Print the first row whose category matches (or the whole list when no
        # category was asked for), as id/path/file_type/category.
        rec="$(printf '%s' "$json" | python3 -c '
import json, sys
want = sys.argv[1].split(",") if sys.argv[1] else None
rows = json.load(sys.stdin).get("data") or []
best = None
for w in rows:
    if not want or str(w.get("category") or "") in want:
        best = w
        break
if best is None and rows and not want:
    best = rows[0]
if best is None:
    sys.exit(0)
print("\t".join(str(best.get(k) or "") for k in ("id", "path", "file_type", "category")))
' "$category" | sed 's|image/jpeg|jpg|; s|image/png|png|; s|image/webp|webp|')" || { log "could not read the API's response"; return 1; }
        IFS=$'\t' read -r got_id img_url imgext got_cat <<< "$rec"
        if [ -z "$img_url" ]; then
            if [ -n "$category" ]; then
                # An empty page is normal when filtering by a minority category:
                # draw again rather than failing.
                log "no $category wallpaper on that page, drawing again"
                continue
            fi
            log "wallhaven returned nothing"
            return 1
        fi
        if [ -z "$category" ] || printf '%s' ",$category," | grep -q ",$got_cat,"; then
            matched=1
            break
        fi
        log "no $category wallpaper on that page (only '$got_cat'), drawing again"
    done
    if [ "$matched" -eq 0 ]; then
        die "wallhaven never served a '$category' wallpaper in $max_tries full pages (its feeds leave nature out entirely — verified by paging) — try general, people or anime, or drop --category"
    fi

    local rdir
    rdir="$(first_dir)" || exit 1
    dest="$rdir/wallhaven-${got_id:-random}.${imgext:-jpg}"
    fetch_to "$img_url" "$dest" || rc=$?  # stdout, not $? -- see save_wallhaven
    case "$rc" in
        0) log "saved $(basename "$dest")" ;;
        2) die "the server did not return an image for $got_id" ;;
        *) die "could not download $got_id" ;;
    esac
    cmd_set "$dest"
}

# ---------------------------------------------------------------------------
# Picker
# ---------------------------------------------------------------------------

# With no arguments, open a picker. The drawer's Wallpapers tab is the real one;
# the fallbacks are for a machine without quickshell (e.g. Debian by default).
open_picker() {
    if command -v appdrawer >/dev/null 2>&1; then
        exec appdrawer wallpapers
    fi
    if command -v rofi >/dev/null 2>&1; then
        local chosen
        chosen="$(cmd_list | rofi -dmenu -i -p "wallpaper")" || exit 0
        [ -n "$chosen" ] && cmd_set "${chosen%%$'\t'*}"
        exit 0
    fi
    for fb in waypaper azote; do
        command -v "$fb" >/dev/null 2>&1 && exec "$fb"
    done
    die "no wallpaper picker available (install the app drawer, rofi, waypaper or azote)"
}

# ---------------------------------------------------------------------------
main() {
    local cmd="${1:-}"
    case "$cmd" in
        list)          shift; cmd_list "$@" ;;
        set)           shift; cmd_set "$@" ;;
        random)        shift; cmd_random "$@" ;;
        current)       cmd_current ;;
        bing)          shift; cmd_bing "$@" ;;
        search)        shift; cmd_search "$@" ;;
        fetch)         shift; cmd_fetch "$@" ;;
        ""|--gui|pick) open_picker ;;
        -h|--help|help)
            # The usage block, stopping at the prose about *why* the engine works
            # the way it does (that is in the source). Anchored on a marker line
            # rather than a line range so it never needs editing when the usage
            # list above it grows.
            awk 'NR == 1 { next }
                 /^# This replaces waypaper/ { exit }
                 { sub(/^# ?/, ""); print }' "$0" ;;
        *)
            # Treat a bare path as `set`, so `simpbar-wallpaper ~/img.jpg` works.
            if [ -e "${cmd/#\~/$HOME}" ]; then
                cmd_set "$cmd"
            else
                die "unknown command: $cmd (try: list, set, random, current, bing, search, fetch)"
            fi
            ;;
    esac
}

main "$@"