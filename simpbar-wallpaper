# The archive behind the daily Bing wallpaper. idx=0 is today and n=8 is as far
# back as this endpoint goes, so it is an 8-day window and not an archive you
# can page arbitrarily deep into.
BING_API="https://www.bing.com/HPImageArchive.aspx"

cmd_bing() {
    local count=1 apply=0 arg
    while [ $# -gt 0 ]; do
        arg="$1"
        case "$arg" in
            --count) count="${2:-}"; shift 2 || die "--count needs a number" ;;
            --count=*) count="${arg#*=}"; shift ;;
            --apply) apply=1; shift ;;
            -h|--help) fetch_help; return 0 ;;
            *) die "unknown option for bing: $arg" ;;
        esac
    done
    need_curl; need_json

    case "$count" in
        ''|*[!0-9]*) die "--count must be a number" ;;
    esac
    [ "$count" -ge 1 ] || die "--count must be at least 1"
    [ "$count" -le 8 ] || die "--count is at most 8 (the archive only serves the last 8 days)"

    local json
    json="$(api_get "$BING_API?format=js&idx=0&n=$count&mkt=en-US")" || return 1

    local dir; dir="$(first_dir)" || exit 1
    mkdir -p "$dir" || die "cannot create $dir"

    local got=0 name date urlbase url copyright dest rc newest=""
    while IFS=$'\t' read -r urlbase url date copyright; do
        [ -n "$urlbase$url" ] || continue
        # Fall back to the name if the date was unparseable; a wallpaper named
        # after Bing's own slug beats one with an empty filename.
        name="bing-${date:-unknown}.jpg"
        dest="$dir/$name"

        if [ -e "$dest" ]; then
            log "already have $name"
        else
            # UHD first: urlbase with the _UHD suffix is the 4K original, and
            # the plain "url" field is a 1920x1080 crop. Fall back to the crop on
            # *any* UHD failure, not just a bad file — an unknown id answers
            # 404, and falling back only on a magic-byte mismatch would skip a
            # perfectly good 1080p download.
            fetch_to "https://www.bing.com${urlbase}_UHD.jpg" "$dest"
            rc=$?
            if [ "$rc" -ne 0 ]; then
                fetch_to "https://www.bing.com${url}" "$dest"
                rc=$?
            fi
            case "$rc" in
                0) log "saved $name  ${copyright:-}" ;;
                2) log "skipped ${date:-an entry}: the server did not return an image" ; continue ;;
                *) log "could not download ${date:-an entry}"; continue ;;
            esac
        fi

        got=$((got + 1))
        [ -n "$newest" ] || newest="$dest"
        printf '%s\n' "$dest"
    done < <(printf '%s' "$json" | python3 -c '
import json, re, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for im in (d.get("images") or []):
    s = re.sub(r"\D", "", str(im.get("startdate") or ""))
    if len(s) == 8:
        day = "%s-%s-%s" % (s[0:4], s[4:6], s[6:8])
    elif len(s) == 6:
        day = "20%s-%s-%s" % (s[4:6], s[0:2], s[2:4])
    else:
        day = ""
    print("\t".join([str(im.get("urlbase") or ""), str(im.get("url") or ""),
                     day, str(im.get("copyright") or "").replace("\t", " ")]))
')

    if [ "$got" -eq 0 ]; then
        log "Bing's archive returned nothing usable"
        return 1
    fi
    # Only the most recent one is applied. Firing cmd_set for every entry would
    # run the swaybg swap and a matugen pass per image and leave whichever
    # happened to be last on screen, which is the oldest of the batch.
    if [ "$apply" -eq 1 ]; then
        log "applying the most recent"
        cmd_set "$newest"
    fi
    return 0
}

